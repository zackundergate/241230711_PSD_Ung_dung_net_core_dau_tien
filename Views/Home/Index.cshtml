@model IEnumerable<_241230711_PSD_Ung_dung_net_core_dau_tien.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}


<div class="container my-4">
    <h2 class="mb-4">Danh sách sản phẩm</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4 text-center">
                <div class="card h-100 border-0 shadow-sm p-3">
                    <img src="@item.Image" class="card-img-top mx-auto" alt="@item.Name" style="max-height: 180px; object-fit: contain;">
                    <div class="card-body d-flex flex-column justify-content-end">
                        <h5 class="card-title fs-6">@item.Name</h5>
                    </div>
                </div>
            </div>
        }
    </div>
</div>